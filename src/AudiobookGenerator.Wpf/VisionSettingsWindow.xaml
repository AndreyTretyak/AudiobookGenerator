<Window x:Class="YewCone.AudiobookGenerator.Wpf.VisionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision model settings"
        Width="850"
        Height="690"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Loaded="HandleLoaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Margin="0 0 0 6" FontWeight="SemiBold" Text="OpenAI-compatible vision profiles"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0 8 0 0" Orientation="Horizontal">
                <Button Margin="0 0 6 0" Click="HandleAddProfile" Content="Add"/>
                <Button Click="HandleRemoveProfile" Content="Remove"/>
            </StackPanel>
            <ListBox x:Name="ProfileList"
                     DisplayMemberPath="DisplayName"
                     SelectionChanged="HandleProfileSelectionChanged"/>
        </DockPanel>

        <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProfileEditor" IsEnabled="False">
                <TextBlock FontWeight="SemiBold" Text="Profile ID"/>
                <TextBox x:Name="ProfileIdTextBox" Margin="0 3 0 8"/>
                <TextBlock FontWeight="SemiBold" Text="Display name"/>
                <TextBox x:Name="DisplayNameTextBox" Margin="0 3 0 8"/>
                <TextBlock FontWeight="SemiBold" Text="Base URL"/>
                <TextBox x:Name="BaseUrlTextBox" Margin="0 3 0 8"/>
                <TextBlock FontWeight="SemiBold" Text="Vision model"/>
                <TextBox x:Name="ModelTextBox" Margin="0 3 0 8"/>
                <TextBlock FontWeight="SemiBold" Text="Description prompt"/>
                <TextBox x:Name="PromptTextBox"
                         Height="100"
                         Margin="0 3 0 8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Temperature"/>
                        <TextBox x:Name="TemperatureTextBox" Margin="0 3 0 8"/>
                        <TextBlock Text="Max image dimension"/>
                        <TextBox x:Name="MaximumImageDimensionTextBox" Margin="0 3 0 8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Max output tokens"/>
                        <TextBox x:Name="MaximumOutputTokensTextBox" Margin="0 3 0 8"/>
                        <TextBlock Text="Max encoded bytes"/>
                        <TextBox x:Name="MaximumImageBytesTextBox" Margin="0 3 0 8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Timeout seconds"/>
                        <TextBox x:Name="TimeoutTextBox" Margin="0 3 0 8"/>
                        <TextBlock Text="Max context characters"/>
                        <TextBox x:Name="MaximumContextCharactersTextBox" Margin="0 3 0 8"/>
                    </StackPanel>
                </Grid>
                <TextBlock FontWeight="SemiBold" Text="API-key environment variable (optional)"/>
                <TextBox x:Name="ApiKeyEnvironmentVariableTextBox" Margin="0 3 0 2"/>
                <TextBlock Margin="0 0 0 8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Only the variable name is saved; the key value is never persisted."/>
                <StackPanel Orientation="Horizontal">
                    <Button Margin="0 0 6 0" Click="HandleSaveProfile" Content="Save profile"/>
                    <Button x:Name="TestButton" Click="HandleTestProfile" Content="Save and test"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0 12 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Margin="0 0 6 0" VerticalAlignment="Center" Text="Default profile:"/>
                <ComboBox x:Name="DefaultProfileComboBox"
                          Width="220"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"
                          SelectionChanged="HandleDefaultProfileChanged"/>
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Column="1"
                       Margin="12 0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <Button Grid.Column="2" Click="HandleClose" Content="Close"/>
        </Grid>
    </Grid>
</Window>
