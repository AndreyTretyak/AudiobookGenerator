<Window x:Class="YewCone.AudiobookGenerator.Wpf.TtsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTS provider settings"
        Width="850"
        Height="650"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Loaded="HandleLoaded"
        Closed="HandleClosed">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0 0 0 6"
                       FontWeight="SemiBold"
                       Text="OpenAI-compatible profiles" />
            <StackPanel DockPanel.Dock="Bottom"
                        Margin="0 8 0 0"
                        Orientation="Horizontal">
                <Button Margin="0 0 6 0"
                        Click="HandleAddProfile"
                        Content="Add" />
                <Button Click="HandleRemoveProfile"
                        Content="Remove" />
            </StackPanel>
            <ListBox x:Name="ProfileList"
                     DisplayMemberPath="DisplayName"
                     SelectionChanged="HandleProfileSelectionChanged" />
        </DockPanel>

        <ScrollViewer Grid.Row="0"
                      Grid.Column="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProfileEditor"
                        IsEnabled="False">
                <TextBlock FontWeight="SemiBold" Text="Profile ID" />
                <TextBox x:Name="ProfileIdTextBox" Margin="0 3 0 10" />

                <TextBlock FontWeight="SemiBold" Text="Display name" />
                <TextBox x:Name="DisplayNameTextBox" Margin="0 3 0 10" />

                <TextBlock FontWeight="SemiBold" Text="Base URL" />
                <TextBox x:Name="BaseUrlTextBox" Margin="0 3 0 2" />
                <TextBlock Margin="0 0 0 10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Use an OpenAI-compatible base URL ending in /v1/. Plain HTTP is allowed only for localhost." />

                <TextBlock FontWeight="SemiBold" Text="Model" />
                <TextBox x:Name="ModelTextBox" Margin="0 3 0 10" />

                <TextBlock FontWeight="SemiBold" Text="Voices" />
                <TextBox x:Name="VoicesTextBox"
                         Height="95"
                         Margin="0 3 0 2"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
                <TextBlock Margin="0 0 0 10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="One per line: id|display name|culture|gender" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontWeight="SemiBold" Text="Speed" />
                        <TextBox x:Name="SpeedTextBox" Margin="0 3 0 10" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock FontWeight="SemiBold" Text="Max input characters" />
                        <TextBox x:Name="MaximumInputTextBox" Margin="0 3 0 10" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock FontWeight="SemiBold" Text="Timeout (seconds)" />
                        <TextBox x:Name="TimeoutTextBox" Margin="0 3 0 10" />
                    </StackPanel>
                </Grid>

                <TextBlock FontWeight="SemiBold" Text="API-key environment variable (optional)" />
                <TextBox x:Name="ApiKeyEnvironmentVariableTextBox" Margin="0 3 0 2" />
                <TextBlock Margin="0 0 0 10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Only the variable name is saved. The key value is never written to settings." />

                <StackPanel Orientation="Horizontal">
                    <Button Margin="0 0 6 0"
                            Click="HandleSaveProfile"
                            Content="Save profile" />
                    <Button x:Name="TestButton"
                            Margin="0 0 6 0"
                            Click="HandleTestProfile"
                            Content="Save and test" />
                    <Button Click="HandleStopPreview"
                            Content="Stop preview" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1"
              Grid.ColumnSpan="3"
              Margin="0 12 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0 0 6 0" VerticalAlignment="Center" Text="Default provider:" />
                <ComboBox x:Name="DefaultProviderComboBox"
                          Width="220"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"
                          SelectionChanged="HandleDefaultProviderChanged" />
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Column="1"
                       Margin="12 0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Grid.Column="2"
                    Click="HandleClose"
                    Content="Close" />
        </Grid>
    </Grid>
</Window>
